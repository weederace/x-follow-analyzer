# Review history now lives in the per-user OS app-data folder (see history_store.py),
# never in the project folder. This entry stays so that a file left behind by an
# older version is still ignored and can never be committed by accident.
processed_history.json

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Android build (generated by `npx cap add android`, ~200 MB of Gradle output).
# Regenerate it with `npm run android:init` instead of committing it.
node_modules/
android/
*.apk
*.aab
*.keystore
*.jks

# Signing secrets must never be committed: a leaked upload key lets someone else
# publish an update in your name.
keystore.properties
local.properties
