# Review history now lives in the per-user OS app-data folder (see history_store.py),
# never in the project folder. This entry stays so that a file left behind by an
# older version is still ignored and can never be committed by accident.
processed_history.json

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Android build (generated by `npx cap add android`, ~200 MB of Gradle output).
# Regenerate it with `npm run android:init` instead of committing it.
# android-res/ is NOT ignored: it holds the launcher icons, which are the one thing in
# android/ that is ours rather than Capacitor's, and they have to survive regeneration.
node_modules/
android/
dist/*
*.apk
*.aab
*.keystore
*.jks

# ...with exactly one exception. The released APK is committed so that "Download ZIP" on
# GitHub carries the Android app too, not only the source: most people who want the phone
# app will never look at the Releases page. Note `dist/*` rather than `dist/` above —
# git cannot re-include a file whose parent directory is itself excluded, so the directory
# has to stay visible for this line to have any effect.
#
# Update it only when cutting a release, never on every build: each new copy is another
# ~4 MB in history that no later commit can remove. tests/test_android.py compares the
# web assets inside it against web/, so a stale one fails the suite instead of shipping.
!dist/follow-desk-debug.apk

# Signing secrets must never be committed: a leaked upload key lets someone else
# publish an update in your name.
keystore.properties
local.properties

# A 3-up contact sheet of the launcher icon, written by tools/make_android_icons.py so
# you can look at what it produced. Nothing reads it, and android-res/ already holds the
# real thing, so committing it would only be a binary that goes stale.
tools/icon-preview.png

# Somewhere to keep your own notes, drafts and throwaway scripts inside the project
# without them ever being published. Nothing in the app reads this folder.
/scratch/
